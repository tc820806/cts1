Singleton {
    // One curve at `progress` (0 = A, 1 = B; outside overshoots).
    function blendCurve(c, progress) {
        const out = [];
        for (let i = 0; i < 8; i++)
            out.push(c[i] + (c[i + 8] - c[i]) * progress);
        return out;
    }

    // The pair as an SVG path `size` px across; the last curve ends where the first starts, so no seam.
    function path(pair, progress, size) {
        if (!pair || pair.length === 0)
            return "";
        const first = blendCurve(pair[0], progress);
        let d = "M " + first[0] * size + " " + first[1] * size;
        for (let i = 0; i < pair.length; i++) {
            const c = i === 0 ? first : blendCurve(pair[i], progress);
            const end = i === pair.length - 1 ? first : c.slice(6);
            d += " C " + c[2] * size + " " + c[3] * size + " " + c[4] * size + " " + c[5] * size + " " + end[0] * size + " " + end[1] * size;
        }
        return d + " Z";
    }

